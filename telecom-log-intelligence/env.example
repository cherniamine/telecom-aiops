# === Copier ce fichier en ".env" et renseigner tes propres valeurs ===
# Ne jamais committer le fichier .env avec de vraies valeurs.

# MongoDB
MONGO_URI=mongodb://localhost:27017/
DATABASE_NAME=telecom_logs

# Collections MongoDB (valeurs par defaut, a adapter si besoin)
COLLECTION_NAME=log_features
ANOMALY_COLLECTION=anomalies
ALERT_COLLECTION=alerts
ALERT_DEDUP_SECONDS=60

# Authentification (dashboard multi-role)
# Le code contient un secret de repli code en dur ("telecom_pfe_secret_2026").
# Definis IMPERATIVEMENT cette variable avec un secret fort avant tout deploiement.
JWT_SECRET=change_me_to_a_strong_random_secret

# Alertes email (SMTP) - utiliser un mot de passe d'application dedie,
# jamais le mot de passe principal du compte
EMAIL_ALERT_SENDER=your_email@gmail.com
EMAIL_ALERT_PASSWORD=your_app_password
EMAIL_ALERT_RECIPIENTS=recipient1@example.com,recipient2@example.com

# API Dashboard (FastAPI)
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8000

# Copilot IA (Ollama)
OLLAMA_MODEL=mistral
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_TIMEOUT_SECONDS=30

# Pipeline temps reel (simulateur)
REALTIME_BUFFER_SIZE=20
REALTIME_BUFFER_MAX_WAIT_SECONDS=5
SIMULATOR_LIMIT=200
SIMULATOR_MIN_DELAY=0.1
SIMULATOR_MAX_DELAY=1.0

# FAISS (recherche semantique)
FAISS_EMBEDDINGS_PATH=data/cache/embeddings.npy
FAISS_DATASET_PATH=data/ml_dataset.parquet
